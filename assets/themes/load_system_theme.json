{
    "#main_button_font": {
        "font": {
            "name": "JetBrains Mono",
            "size": "18",
            "bold": "1",
            "regular_path": "assets/fonts/JetBrainsMonoNerdFont-Medium.ttf"
        }
    },
    "#system_button_font": {
        "font": {
            "name": "JetBrains Mono",
            "size": "14",
            "regular_path": "assets/fonts/JetBrainsMonoNerdFont-Regular.ttf"
        }
    },
    "#label_font": {
        "font": {
            "name": "JetBrains Mono",
            "size": "16",
            "bold": "1",
            "regular_path": "assets/fonts/JetBrainsMonoNerdFont-SemiBold.ttf"
        }
    },
    "#title_font": {
        "font": {
            "name": "JetBrains Mono",
            "size": "24",
            "bold": "1",
            "regular_path": "assets/fonts/JetBrainsMonoNerdFont-Bold.ttf"
        }
    },
    "button": {
        "prototype": "#main_button_font",
        "colours": {
            "normal_bg": "#1a365d",
            "hovered_bg": "#2a4a7a",
            "active_bg": "#0f2847",
            "disabled_bg": "#1e3a5f",
            "normal_text": "#e2e8f0",
            "hovered_text": "#ffffff",
            "active_text": "#94a3b8",
            "disabled_text": "#64748b",
            "normal_border": "#3b82f6",
            "hovered_border": "#60a5fa",
            "active_border": "#2563eb",
            "disabled_border": "#334155"
        },
        "misc": {
            "shape": "rounded_rectangle",
            "shape_corner_radius": "12",
            "border_width": "2",
            "shadow_width": "4",
            "text_horiz_alignment": "center",
            "text_vert_alignment": "center"
        }
    },
    "#system_button": {
        "prototype": "#system_button_font",
        "colours": {
            "normal_bg": "#0f2847",
            "hovered_bg": "#1e4976",
            "active_bg": "#0a1c33",
            "disabled_bg": "#1e3a5f",
            "normal_text": "#cbd5e1",
            "hovered_text": "#f1f5f9",
            "active_text": "#94a3b8",
            "disabled_text": "#64748b",
            "normal_border": "#2563eb",
            "hovered_border": "#3b82f6",
            "active_border": "#1d4ed8",
            "disabled_border": "#334155"
        },
        "misc": {
            "shape": "rounded_rectangle",
            "shape_corner_radius": "8",
            "border_width": "1",
            "shadow_width": "2",
            "text_horiz_alignment": "center",
            "text_vert_alignment": "center"
        }
    },
    "panel": {
        "colours": {
            "dark_bg": "#0c1929",
            "normal_border": "#1e40af"
        },
        "misc": {
            "shape": "rounded_rectangle",
            "shape_corner_radius": "16",
            "border_width": "2",
            "shadow_width": "6"
        }
    },
    "scrolling_container": {
        "colours": {
            "dark_bg": "#0c1929"
        },
        "misc": {
            "shape": "rounded_rectangle",
            "shape_corner_radius": "12"
        }
    },
    "vertical_scroll_bar": {
        "colours": {
            "dark_bg": "#0a1525",
            "normal_border": "#1e3a5f"
        },
        "misc": {
            "shape": "rounded_rectangle",
            "shape_corner_radius": "8",
            "border_width": "1"
        }
    },
    "vertical_scroll_bar.#sliding_button": {
        "colours": {
            "normal_bg": "#2563eb",
            "hovered_bg": "#3b82f6",
            "active_bg": "#1d4ed8",
            "normal_border": "#60a5fa",
            "hovered_border": "#93c5fd",
            "active_border": "#3b82f6"
        },
        "misc": {
            "shape": "rounded_rectangle",
            "shape_corner_radius": "6",
            "border_width": "1"
        }
    },
    "vertical_scroll_bar.button": {
        "colours": {
            "normal_bg": "#1e3a5f",
            "hovered_bg": "#2a4a7a",
            "active_bg": "#0f2847",
            "normal_border": "#3b82f6",
            "hovered_border": "#60a5fa",
            "active_border": "#2563eb"
        },
        "misc": {
            "shape": "rounded_rectangle",
            "shape_corner_radius": "4",
            "border_width": "1"
        }
    },
    "label": {
        "prototype": "#label_font",
        "colours": {
            "dark_bg": "#00000000",
            "normal_text": "#e2e8f0"
        }
    },
    "#title_label": {
        "prototype": "#title_font",
        "colours": {
            "dark_bg": "#00000000",
            "normal_text": "#f1f5f9"
        }
    },
    "#section_label": {
        "prototype": "#label_font",
        "colours": {
            "dark_bg": "#00000000",
            "normal_text": "#94a3b8"
        }
    }
}
